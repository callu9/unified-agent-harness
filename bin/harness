#!/usr/bin/python3
"""agent-harness: one source for global rules, gates and project enrollment across agents.

  harness apply [--write] [--adopt]   render rules into every detected agent, register hooks,
                                      link ~/.agent-harness and the global Git hooks
                                      (preview by default; --adopt drops unmarked legacy text)
  harness doctor [--workspace DIR]    compare live state with this checkout
  harness enroll [--repo PATH] [--apply] [-- <command>...]
  harness verify run|status [--repo PATH] [--json] [-- <command>...]
  harness audit [...]                 repeated corrections in Codex and Claude Code logs
"""
import difflib
import glob
import json
import os
import re
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "checks"))
import gates  # noqa: E402
import harness_verify  # noqa: E402

LINK = os.path.expanduser("~/.agent-harness")
PYTHON = "/usr/bin/python3" if os.path.exists("/usr/bin/python3") else sys.executable
START, END = "<!-- agent-harness:start -->", "<!-- agent-harness:end -->"
BLOCK = re.compile(r"<!-- ([\w.-]+):start -->.*?<!-- \1:end -->", re.S)
# (event, script) pairs registered for agents with hook support; one group per hook keeps
# the group shape Codex already trusts.
HOOKS = (("UserPromptSubmit", "turn_contract.py", None, 10),
         ("PreToolUse", "branch_name_guard.py", "shell", 5),
         ("PreToolUse", "commit_gate.py", "shell", 10),
         ("PreToolUse", "codex_model_guard.py", "shell", 5),
         ("Stop", "korean_answer_check.py", None, 10),
         ("SubagentStop", "korean_answer_check.py", None, 10))
BACKUP_SUFFIX = ".bak-agent-harness"


def expand(path):
    return os.path.expanduser(path) if path else path


def adapters():
    found = []
    for path in sorted(glob.glob(os.path.join(ROOT, "adapters", "*.json"))):
        if os.path.basename(path).startswith("_"):
            continue
        with open(path, encoding="utf-8") as fh:
            found.append(json.load(fh))
    return found


def detected(adapter):
    return os.path.isdir(expand(adapter["home"]))


def render(adapter):
    has_hooks = bool(adapter.get("hooks_file"))
    values = {
        "gates": "\n".join(gates.lines(agent_hooks=has_hooks)),
        "turn_contract": ("등록 저장소에서는 매 턴 `<harness-turn-contract>` 블록으로 게이트와 현재 상태"
                          "(branch, 변경 수, 검증 상태)가 다시 주입된다.\n" if has_hooks else ""),
        "harness": os.path.join(LINK, "bin", "harness"),
    }
    parts = []
    for path in sorted(glob.glob(os.path.join(ROOT, "rules", "*.md"))):
        with open(path, encoding="utf-8") as fh:
            parts.append(fh.read().strip())
    body = "\n\n".join(parts)
    body = re.sub(r"\{\{(\w+)\}\}", lambda m: values[m.group(1)], body)
    body = re.sub(r"\n{3,}", "\n\n", body)
    return f"{START}\n{body}\n{END}"


def split(text, adapter):
    """Return (foreign marker blocks to keep, unmarked text outside any block)."""
    drop = {"agent-harness"} | set(adapter.get("legacy_blocks", ()))
    keep = [m.group(0) for m in BLOCK.finditer(text) if m.group(1) not in drop]
    loose = BLOCK.sub("", text)
    for line in adapter.get("legacy_lines", ()):
        loose = re.sub(rf"^{re.escape(line)}\s*$", "", loose, flags=re.M)
    return keep, loose.strip()


def compose(text, adapter, adopt):
    keep, loose = split(text, adapter)
    parts = [render(adapter)] + ([] if adopt or not loose else [loose]) + keep
    return "\n\n".join(parts) + "\n"


def hook_command(script):
    return f"{PYTHON} -B {os.path.join(LINK, 'checks', script)}"


def ours(command, adapter):
    legacy = [expand(p) for p in adapter.get("legacy_hook_paths", ())]
    return any(p in command for p in legacy) or os.path.join(LINK, "checks") in command


def merge_hooks(settings, adapter):
    hooks = settings.setdefault("hooks", {})
    for event, groups in list(hooks.items()):
        for group in groups:
            group["hooks"] = [h for h in group.get("hooks", []) if not ours(h.get("command", ""), adapter)]
        hooks[event] = [g for g in groups if g["hooks"]]
    for index, (event, script, matcher, timeout) in enumerate(HOOKS):
        group = {"hooks": [{"type": "command", "command": hook_command(script), "timeout": timeout}]}
        if matcher:
            group = {"matcher": adapter["shell_matcher"], **group}
        groups = hooks.setdefault(event, [])
        # The turn contract goes first so it frames the other context hooks.
        groups.insert(0, group) if event == "UserPromptSubmit" else groups.append(group)
    for key, value in adapter.get("settings", {}).items():
        # Dict values merge one level deep so user keys (e.g. env.HTTPS_PROXY) survive.
        if isinstance(value, dict) and isinstance(settings.get(key), dict):
            settings[key].update(value)
        else:
            settings[key] = value
    return settings


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except FileNotFoundError:
        return ""


def planned(adopt):
    """(path, current text, new text) for every file apply manages."""
    plan = []
    for adapter in filter(detected, adapters()):
        path = expand(adapter["global_file"])
        current = read(path)
        plan.append((path, current, compose(current, adapter, adopt)))
        if adapter.get("hooks_file"):
            path = expand(adapter["hooks_file"])
            current = read(path)
            settings = merge_hooks(json.loads(current or "{}"), adapter)
            plan.append((path, current, json.dumps(settings, ensure_ascii=False, indent=2) + "\n"))
    return plan


def git_hooks_path():
    out = subprocess.run(("git", "config", "--global", "--get", "core.hooksPath"),
                         capture_output=True, text=True)
    return out.stdout.strip()


def cmd_apply(args):
    write, adopt = "--write" in args, "--adopt" in args
    changed = False
    for path, current, new in planned(adopt):
        if current == new:
            continue
        changed = True
        sys.stdout.writelines(difflib.unified_diff(
            current.splitlines(True), new.splitlines(True), path, path + " (new)"))
        if write:
            if current and not os.path.exists(path + BACKUP_SUFFIX):
                shutil.copy2(path, path + BACKUP_SUFFIX)  # The pre-harness original, kept once.
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path + ".tmp", "w", encoding="utf-8") as fh:
                fh.write(new)
            os.replace(path + ".tmp", path)
    if os.path.islink(LINK) and os.path.realpath(LINK) != ROOT or (os.path.exists(LINK) and not os.path.islink(LINK)):
        print(f"FAIL {LINK} points elsewhere ({os.path.realpath(LINK)}); fix it by hand.")
        return 1
    if not os.path.islink(LINK):
        changed = True
        print(f"link {LINK} -> {ROOT}")
        if write:
            os.symlink(ROOT, LINK)
    want = os.path.join(LINK, "githooks")
    current = git_hooks_path()
    if current not in ("", want):
        print(f"WARN global core.hooksPath is {current}; leaving it. Git-layer gates are off.")
    elif current != want:
        changed = True
        print(f"git config --global core.hooksPath {want}")
        if write:
            subprocess.run(("git", "config", "--global", "core.hooksPath", want), check=True)
    if not changed:
        print("apply: already up to date.")
    elif not write:
        print("\napply: preview only. Re-run with --write to apply.")
    return 0


def repo_report(repo, agents):
    issues = []
    agents_md = os.path.exists(os.path.join(repo, "AGENTS.md"))
    if not agents_md:
        issues.append("AGENTS.md 없음")
    for adapter in agents:
        pointer = adapter.get("project_pointer")
        if agents_md and pointer and not os.path.exists(os.path.join(repo, adapter["project_file"])):
            issues.append(f"{adapter['project_file']} 포인터 없음")
    enrolled = os.path.exists(os.path.join(repo, harness_verify.CONFIG_RELATIVE))
    local_hooks = subprocess.run(("git", "-C", repo, "config", "--local", "--get", "core.hooksPath"),
                                 capture_output=True, text=True).stdout.strip()
    if enrolled and local_hooks:
        issues.append(f"로컬 core.hooksPath={local_hooks} 라 git 층 게이트 미적용 (agent hook 은 적용)")
    return enrolled, issues


def cmd_doctor(args):
    failures = 0

    def report(ok, label, detail=""):
        nonlocal failures
        failures += 0 if ok else 1
        print(f"{'PASS' if ok else 'FAIL'} {label}{(' — ' + detail) if detail else ''}")

    report(os.path.realpath(LINK) == ROOT, f"{LINK} -> this checkout", os.path.realpath(LINK))
    report(git_hooks_path() == os.path.join(LINK, "githooks"), "global core.hooksPath", git_hooks_path() or "unset")
    agents = [a for a in adapters() if detected(a)]
    for path, current, new in planned(adopt=False):
        report(current == new, f"{path} matches rules/ and adapters/", "" if current == new else "run `harness apply`")
    for adapter in agents:
        _keep, loose = split(read(expand(adapter["global_file"])), adapter)
        if loose:
            print(f"WARN {adapter['global_file']} has unmarked text outside managed blocks "
                  "(move it into rules/ or a project, then `harness apply --write --adopt`)")
    for _event, script, _m, _t in HOOKS:
        report(os.path.exists(os.path.join(LINK, "checks", script)), f"check script {script}")

    print("\n| capability | " + " | ".join(a["name"] for a in adapters()) + " |")
    print("|---|" + "---|" * len(adapters()))
    rows = (("installed", lambda a: detected(a)),
            ("global rules", lambda a: True),
            ("project file", lambda a: a.get("project_pointer") and f"{a['project_file']} → AGENTS.md"
             or a["project_file"]),
            ("turn contract", lambda a: bool(a.get("hooks_file"))),
            ("agent gates", lambda a: bool(a.get("hooks_file"))),
            ("git-layer gates", lambda a: True))
    for label, fn in rows:
        cells = [fn(a) for a in adapters()]
        print(f"| {label} | " + " | ".join(c if isinstance(c, str) else ("yes" if c else "no")
                                         for c in cells) + " |")

    if "--workspace" in args:
        base = expand(args[args.index("--workspace") + 1])
        print(f"\n# repositories under {base}")
        for repo in sorted(glob.glob(os.path.join(base, "*", ".git"))):
            repo = os.path.dirname(repo)
            enrolled, issues = repo_report(repo, agents)
            mark = "enrolled" if enrolled else "-"
            print(f"{os.path.basename(repo):40} {mark:9} {'; '.join(issues) or 'ok'}")
    return 1 if failures else 0


def cmd_enroll(args):
    repo_arg, write, commands = os.getcwd(), "--apply" in args, []
    if "--" in args:
        commands = args[args.index("--") + 1:]
        args = args[:args.index("--")]
    if "--repo" in args:
        repo_arg = args[args.index("--repo") + 1]
    repo = harness_verify.repo_root(expand(repo_arg))
    code = harness_verify.enroll(repo, write, commands)
    agents_md = os.path.exists(os.path.join(repo, "AGENTS.md"))
    for adapter in filter(detected, adapters()):
        pointer = adapter.get("project_pointer")
        target = os.path.join(repo, adapter["project_file"])
        if not pointer or os.path.exists(target):
            continue
        if not agents_md:
            print(f"enroll: no AGENTS.md, so no {adapter['project_file']} pointer was created.")
            continue
        print(f"enroll: {'created' if write else 'would create'} {target} ({pointer})")
        if write:
            with open(target, "w", encoding="utf-8") as fh:
                fh.write(pointer + "\n")
    _enrolled, issues = repo_report(repo, [])
    for issue in issues:
        print(f"WARN {issue}")
    return code


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    action, rest = argv[0], argv[1:]
    if action == "apply":
        return cmd_apply(rest)
    if action == "doctor":
        return cmd_doctor(rest)
    if action == "enroll":
        return cmd_enroll(rest)
    if action == "verify":
        return harness_verify.main(rest)
    if action == "audit":
        import repeat_audit
        return repeat_audit.main(rest)
    print(f"harness: unknown action {action!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
